# Gold Tier - Odoo Community Integration Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# ODOO CONFIGURATION
# ============================================================================

ODOO_URL=http://localhost:8069
ODOO_DB=ai_employee_accounting
ODOO_USERNAME=api@aiemployee.local
ODOO_PASSWORD=your_secure_password_here
USE_MOCK_ODOO=true

# ============================================================================
# CEO BRIEFING CONFIGURATION
# ============================================================================

CEO_BRIEFING_ENABLED=true
CEO_BRIEFING_DAY=sunday
CEO_BRIEFING_TIME=07:00

# ============================================================================
# SOCIAL MEDIA CONFIGURATION
# ============================================================================

SOCIAL_MEDIA_MOCK=true
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ============================================================================
# VAULT CONFIGURATION
# ============================================================================

VAULT_PATH=/path/to/your/vault

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90
