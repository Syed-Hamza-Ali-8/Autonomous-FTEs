# Customer Success Digital FTE - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE
# ============================================================================
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://fte_user:your_secure_password_here@localhost:5432/customer_success_fte

# ============================================================================
# OPENAI API
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# GMAIL API
# ============================================================================
# Path to Gmail API credentials JSON file
GMAIL_CREDENTIALS_PATH=./credentials/gmail-credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail-token.json
GMAIL_SUPPORT_EMAIL=support@techcorp.com

# ============================================================================
# TWILIO (WhatsApp)
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp

# ============================================================================
# KAFKA
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_INCOMING=fte.tickets.incoming
KAFKA_TOPIC_ESCALATIONS=fte.escalations
KAFKA_TOPIC_METRICS=fte.metrics
KAFKA_TOPIC_DLQ=fte.dlq
KAFKA_CONSUMER_GROUP=fte-workers

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# APPLICATION
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# MONITORING
# ============================================================================
GRAFANA_PASSWORD=admin_change_me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============================================================================
# SECURITY
# ============================================================================
# Secret key for JWT tokens and session management
SECRET_KEY=your-secret-key-change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Escalation thresholds
ESCALATION_SENTIMENT_THRESHOLD=0.3
ESCALATION_KB_RELEVANCE_THRESHOLD=0.5

# Response configuration
MAX_RESPONSE_LENGTH_EMAIL=2000
MAX_RESPONSE_LENGTH_WHATSAPP=1600
MAX_RESPONSE_LENGTH_WEB=1500

# Knowledge base
KB_SEARCH_MAX_RESULTS=5
KB_EMBEDDING_BATCH_SIZE=100

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_GMAIL_INTEGRATION=true
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_WEB_FORM_INTEGRATION=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_METRICS_COLLECTION=true
