# Tollgate environment template. Copy to `.env` (repo root, git-ignored) and fill in.
# NEVER commit real values. NEVER paste these values into chat.
# Later phases append their variables here.

# ---------------------------------------------------------------------------
# LLM provider (backend only). Model IDs come from the provider's /models
# endpoint: run `uv run python scripts/resolve_models.py` in backend/.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq                 # groq | gemini
GROQ_API_KEY=                     # console.groq.com -> API Keys
GEMINI_API_KEY=                   # optional; Google AI Studio -> API key
# Base URLs default to the official values (verified 2026-11-07); override only if the provider changes them.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_FAST=                       # exact ID from resolve_models.py output
MODEL_STRONG=                     # exact ID from resolve_models.py output (may equal MODEL_FAST)

# ---------------------------------------------------------------------------
# LOCAL Supabase (dev + ALL tests). Values come from `supabase status`
# after `supabase start`. Tests refuse to run unless DATABASE_URL is localhost.
# ---------------------------------------------------------------------------
DATABASE_URL=                     # local Postgres URL from `supabase status`
SUPABASE_URL=                     # local API URL from `supabase status`
SUPABASE_ANON_KEY=                # local anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=        # local service_role / secret key (backend scripts only)

# ---------------------------------------------------------------------------
# CLOUD Supabase (demo only; used by `seed_store.py --target cloud` and deployment).
# Copy from the project's Connect panel and API settings. Use the SESSION-mode
# pooler string (the direct connection may be IPv6-only and unreachable from WSL).
# ---------------------------------------------------------------------------
CLOUD_DATABASE_URL=               # Connect panel -> Session pooler
CLOUD_SUPABASE_URL=               # https://<project-ref>.supabase.co
CLOUD_SUPABASE_ANON_KEY=          # anon / publishable key
CLOUD_SUPABASE_SERVICE_ROLE_KEY=  # service_role / secret key; never in the frontend

# ---------------------------------------------------------------------------
# Frontend: these go in frontend/.env.local (also git-ignored). Only public values.
# The frontend never receives the service-role key or the database URL.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=http://localhost:8000
